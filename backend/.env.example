NODE_ENV=development
PORT=3000

# MongoDB Atlas or local MongoDB connection string. Never commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Use long, random values. Never expose these to the frontend.
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Comma-separated browser origins. CLIENT_ORIGIN is retained for compatibility.
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173

# Admin self-registration requires this secret invite code.
ADMIN_INVITE_CODE=replace_with_a_long_random_admin_invite_code

# Optional legacy/bootstrap integrations.
ADMIN_PASSWORD=replace_with_a_secure_legacy_admin_password
SUPER_ADMIN_BOOTSTRAP_SECRET=replace_with_a_secure_bootstrap_secret
SUPER_ADMIN_EMAIL=molladerbew95@gmail.com
SUPER_ADMIN_INITIAL_PASSWORD=replace_with_a_secure_initial_password
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=HydroOS <no-reply@example.com>
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# Cross-site frontend/backend deployments may use: none.
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
