NODE_ENV=development
PORT=3000

# MongoDB Atlas or local MongoDB connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Use long, random values. Never expose these to the frontend.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Comma-separated browser origins. CLIENT_ORIGIN is retained for compatibility.
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173

# Optional legacy/bootstrap integrations. Replace placeholders locally only.
ADMIN_PASSWORD=
SUPER_ADMIN_BOOTSTRAP_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=

# Resend email delivery.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=HydroOS <onboarding@resend.dev>

# Cloudinary credentials (optional).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cross-site frontend/backend deployments may use: none.
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
